# 复制为 deploy.env 后按实际环境修改（deploy.env 已加入 gitignore）

# Linux 服务器
DEPLOY_HOST=124.220.57.33
DEPLOY_USER=ubuntu
DEPLOY_PORT=22

# jar / Dockerfile / compose 上传到该目录
DEPLOY_REMOTE_DIR=/opt/leonpro/backend

# 密码登录（与 DEPLOY_SSH_KEY 二选一；优先密钥）
DEPLOY_PASSWORD=

# 可选：私钥路径。留空则使用密码或默认密钥
DEPLOY_SSH_KEY=

# 1=跳过 mvn package，只上传已有 deploy/dist/app.jar
SKIP_BUILD=0

# 1=上传后在服务器执行 docker compose up -d --build（Java 容器会重建并启动）
DOCKER_UP=1
