# 复制为 bootstrap.env 后按新服务器修改。不要提交真实密码。

# 远程执行（本机 bootstrap.ps1 使用）
DEPLOY_HOST=
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
DEPLOY_PASSWORD=
DEPLOY_SSH_KEY=

# MySQL root 密码（须与 application-prod.yml 的 MYSQL_PASSWORD 一致，或后续改后端环境变量）
MYSQL_ROOT_PASSWORD=Root@123456

# 仅监听本机 3306，避免公网扫库。需要外网连库时改为 0.0.0.0:3306:3306
MYSQL_PUBLISH=127.0.0.1:3306:3306

# 可选：Docker 镜像加速，例如 https://docker.m.daocloud.io 。留空则不改 daemon.json
DOCKER_MIRROR=

# 1=安装并开启 ufw（放行 22/80/443）
SETUP_UFW=0
