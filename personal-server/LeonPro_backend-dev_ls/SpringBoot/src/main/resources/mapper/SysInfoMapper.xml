<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="springboot.mapper.SysInfoMapper">

    <resultMap id="BaseResultMap" type="springboot.domain.SysInfo">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="infoDes" column="info_des" jdbcType="VARCHAR"/>
            <result property="infoStatus" column="info_status" jdbcType="INTEGER"/>
            <result property="infoType" column="info_type" jdbcType="INTEGER"/>
            <result property="publicId" column="public_id" jdbcType="VARCHAR"/>
            <result property="userId" column="user_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,create_time,info_des,
        info_status,info_type,public_id,
        user_id
    </sql>
</mapper>
