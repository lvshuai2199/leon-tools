<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="springboot.mapper.SysTasksMapper">

    <resultMap id="BaseResultMap" type="springboot.domain.SysTasks">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="handlerId" column="handler_id" jdbcType="VARCHAR"/>
            <result property="publisherId" column="publisher_id" jdbcType="VARCHAR"/>
            <result property="taskLevel" column="task_level" jdbcType="VARCHAR"/>
