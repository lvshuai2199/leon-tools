            <result property="customerName" column="customer_name" jdbcType="VARCHAR"/>
            <result property="customerPlace" column="customer_place" jdbcType="VARCHAR"/>
            <result property="industry" column="industry" jdbcType="VARCHAR"/>
            <result property="robotNum" column="robot_num" jdbcType="VARCHAR"/>
            <result property="robotType" column="robot_type" jdbcType="VARCHAR"/>
            <result property="scenario" column="scenario" jdbcType="VARCHAR"/>
            <result property="taskType" column="task_type" jdbcType="VARCHAR"/>
            <result property="taskStatus" column="task_status" jdbcType="VARCHAR"/>
            <result property="remarks" column="remarks" jdbcType="VARCHAR"/>
            <result property="isDelete" column="is_delete" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,create_time,description,
        handler_id,publisher_id,task_level,
        task_name,customer_name,
        customer_place,industry,robot_num,
        robot_type,scenario,task_type,
        task_status,remarks,is_delete
