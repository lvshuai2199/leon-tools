        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="springboot.mapper.ExternWalletMapper">

    <resultMap id="BaseResultMap" type="springboot.domain.ExternWallet">
            <id property="id" column="id" jdbcType="VARCHAR"/>
