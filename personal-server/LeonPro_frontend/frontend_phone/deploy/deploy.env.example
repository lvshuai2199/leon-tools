# 复制为 deploy.env 后按实际环境修改（deploy.env 已加入 gitignore）
# 上传目录固定为 /var/www/leonpro-web（写在 deploy.ps1 里），不再需要 DEPLOY_REMOTE_DIR；
# 脚本不再改 nginx，不再需要 DEPLOY_NGINX_CONF / NGINX_RELOAD。

DEPLOY_HOST=124.220.57.33
DEPLOY_USER=ubuntu
DEPLOY_PORT=22

# 留空则依次复用 bootstrap/bootstrap.env、后端 deploy.env 里的登录方式
DEPLOY_PASSWORD=
DEPLOY_SSH_KEY=

# 1=跳过 npm run build，只上传已有 dist/
SKIP_BUILD=0
