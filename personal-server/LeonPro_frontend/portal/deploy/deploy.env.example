# 复制为 deploy.env 后按实际环境修改（deploy.env 已加入 .gitignore）

DEPLOY_HOST=124.220.57.33
DEPLOY_USER=ubuntu
DEPLOY_PORT=22

# 静态文件目录（不要放进 /var/www/leonpro，Vue 管理端部署会清空该目录）
DEPLOY_REMOTE_DIR=/var/www/leonpro-portal

# 写入并重载的 Nginx 站点配置（与 vue3_frontend/deploy/nginx.conf 共用）
DEPLOY_NGINX_CONF=/etc/nginx/sites-available/default

# 留空时自动读取 bootstrap/bootstrap.env 或后端 deploy.env 里的密码
DEPLOY_PASSWORD=
DEPLOY_SSH_KEY=

# 1=跳过 pnpm build，只上传已有 dist/
SKIP_BUILD=0

# 1=上传后 nginx -t && reload
NGINX_RELOAD=1
